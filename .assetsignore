# Files that should NOT be served as static assets by the Worker.
/cf/
/node_modules/
# `.git` matches both a real dir AND a worktree's `.git` FILE (gitdir pointer),
# so deploying from a git worktree doesn't publish it. Same for wrangler's build dir.
/.git
/.wrangler
# Nested git worktrees live under `.claude/worktrees/*` and are NOT part of the
# site. The `/downloads/` rule below is root-anchored, so a worktree's own
# `downloads/` was still being collected — which fails the deploy outright
# ("Asset too large" on a bundled .dmg) and would otherwise publish whatever a
# worktree happens to contain.
/.claude/
/.github/
/server-lock/
/downloads/
/wrangler.jsonc
/.assetsignore
/package.json
/package-lock.json
/serve.py
/.dev.vars
*.md
.DS_Store
